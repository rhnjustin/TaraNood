<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_title_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Item"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/edit_poster"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#333333"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_select_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Select Image"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title"
            android:textColorHint="#888888"
            app:hintTextColor="@color/white"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:layout_marginBottom="24dp" />

        <!-- Dynamic sections for progress based on type -->
        <LinearLayout
            android:id="@+id/layout_progress_movie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/input_minutes_watched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Minutes Watched"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/input_total_runtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Total Runtime (min)"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_progress_series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_episodes_watched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Episodes Watched"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/input_total_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Total Episodes"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/input_current_ep_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Current Episode Minutes"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/input_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes"
            android:gravity="top"
            android:lines="3"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Item" />

    </LinearLayout>
</ScrollView>
