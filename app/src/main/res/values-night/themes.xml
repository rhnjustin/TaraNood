<!-- Place this file at: res/values-night/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TaraNood" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sky_blue</item>
        <item name="colorPrimaryVariant">@color/sky_blue_dark</item>
        <item name="colorSecondary">@color/vivid_orange</item>
        <item name="colorSecondaryVariant">@color/vivid_orange</item>
        <item name="colorAccent">@color/sky_blue</item>
        <item name="android:colorAccent">@color/sky_blue</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark</item>
        <item name="colorSurfaceContainer">@color/card_surface_dark</item>
        <item name="colorControlActivated">@color/sky_blue</item>
        <item name="colorControlHighlight">@color/sky_blue_alpha</item>
        <item name="switchStyle">@style/AppSwitchStyle</item>
    </style>

    <style name="Theme.TaraNood" parent="Base.Theme.TaraNood" />

    <style name="AppSwitchStyle" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="colorPrimary">@color/sky_blue</item>
        <item name="colorAccent">@color/sky_blue</item>
        <item name="android:colorAccent">@color/sky_blue</item>
        <item name="colorControlActivated">@color/sky_blue</item>
        <item name="colorButtonNormal">@color/sky_blue</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>